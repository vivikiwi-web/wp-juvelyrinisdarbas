# OS and editor temporary files. Keep shared Cursor rules tracked.
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Dependencies and caches (if introduced later).
node_modules/
vendor/
.cache/
.phpunit.cache/
.phpunit.result.cache
coverage/
__pycache__/
*.py[cod]
assets/css/*.map

# Secrets and machine-specific settings.
.env
.env.*
!.env.example
wp-config.php
wp-cli.local.yml
*.pem
*.key
auth.json
.npmrc

# Database exports, backups, logs and release archives.
*.sql
*.sql.*
*.sqlite
*.sqlite3
*.log
*.bak
*.backup
*.zip
*.tar
*.tar.gz
*.tgz
/backups/
/private/
/tmp/

# Unedited source photos are kept locally for processing, outside Git history.
/project-files/catalog-photos/originals/
